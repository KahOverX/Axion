-- TPWalk RunService.Heartbeat:Connect(function(dt) if tpwalkEnabled and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then local root = player.Character.HumanoidRootPart local cam = workspace.CurrentCamera local moveVec = Vector3.zero

if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVec += cam.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVec -= cam.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVec -= cam.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVec += cam.CFrame.RightVector end

    moveVec = Vector3.new(moveVec.X, 0, moveVec.Z)
    if moveVec.Magnitude > 0 then
        local dir = moveVec.Unit
        local newPos = root.Position + dir * tpwalkSpeed * dt
        root.CFrame = CFrame.new(newPos, newPos + dir)
    end
end

end)

-- Invisibility Animation Loop local function playInvisibilityAnimation() local char = player.Character if not char then return end local humanoid = char:FindFirstChildOfClass("Humanoid") local animator = humanoid and humanoid:FindFirstChildWhichIsA("Animator") if not animator then return end

for _, track in pairs(animator:GetPlayingAnimationTracks()) do
    table.insert(savedTracks, {Track = track, TimePosition = track.TimePosition})
    track:Stop()
end

local anim = Instance.new("Animation")
anim.AnimationId = "rbxassetid://75804462760596"
invisTrack = animator:LoadAnimation(anim)
invisTrack:Play()

task.spawn(function()
    while invisEnabled and invisTrack do
        invisTrack:Play()
        invisTrack.TimePosition = 0.001
        task.wait(0.05)
    end
end)

end

local function stopInvisibilityAnimation() if invisTrack then invisTrack:Stop() invisTrack = nil end local char = player.Character if not char then return end local humanoid = char:FindFirstChildOfClass("Humanoid") local animator = humanoid and humanoid:FindFirstChildWhichIsA("Animator") if not animator then return end

for _, saved in ipairs(savedTracks) do
    local anim = Instance.new("Animation")
    anim.AnimationId = saved.Track.Animation.AnimationId
    local newTrack = animator:LoadAnimation(anim)
    newTrack:Play()
    newTrack.TimePosition = saved.TimePosition
end
savedTracks = {}

end

