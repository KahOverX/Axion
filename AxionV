-- ESP Killer
local function updateKillerESP()
    if workspace.Players and workspace.Players.Killers then
        for _, model in pairs(workspace.Players.Killers:GetChildren()) do
            if model:IsA("Model") and model:FindFirstChild("HumanoidRootPart") then
                if not model:FindFirstChild("ESPHighlight") then
                    local h = Instance.new("Highlight")
                    h.Name = "ESPHighlight"
                    h.Adornee = model
                    h.FillColor = Color3.fromRGB(85, 0, 0)
                    h.OutlineColor = Color3.fromRGB(255, 0, 0)
                    h.FillTransparency = 0.5
                    h.OutlineTransparency = 0
                    h.Parent = model
                end

                if not model:FindFirstChild("ESPText") and model:FindFirstChild("Head") then
                    local bill = Instance.new("BillboardGui")
                    bill.Name = "ESPText"
                    bill.Adornee = model.Head
                    bill.Size = UDim2.new(0, 200, 0, 40)
                    bill.StudsOffset = Vector3.new(0, 2, 0)
                    bill.AlwaysOnTop = true
                    bill.Parent = model

                    local label = Instance.new("TextLabel")
                    label.Size = UDim2.new(1, 0, 1, 0)
                    label.BackgroundTransparency = 1
                    label.Text = model.Name
                    label.TextColor3 = Color3.fromRGB(255, 0, 0)
                    label.TextStrokeTransparency = 0.2
                    label.TextStrokeColor3 = Color3.fromRGB(85, 0, 0)
                    label.Font = Enum.Font.Antique
                    label.TextScaled = true
                    label.Parent = bill
                end
            end
        end
    end
end

local function removeKillerESP()
    if workspace.Players and workspace.Players.Killers then
        for _, model in pairs(workspace.Players.Killers:GetChildren()) do
            local h = model:FindFirstChild("ESPHighlight")
            if h then h:Destroy() end
            local b = model:FindFirstChild("ESPText")
            if b then b:Destroy() end
        end
    end
end

-- ESP Survivor
local function updateSurvivorESP()
    if workspace.Players and workspace.Players.Survivors then
        for _, model in pairs(workspace.Players.Survivors:GetChildren()) do
            if model:IsA("Model") and model:FindFirstChild("Head") then
                if not model:FindFirstChild("ESPText") then
                    local bill = Instance.new("BillboardGui")
                    bill.Name = "ESPText"
                    bill.Adornee = model.Head
                    bill.Size = UDim2.new(0, 200, 0, 40)
                    bill.StudsOffset = Vector3.new(0, 2, 0)
                    bill.AlwaysOnTop = true
                    bill.Parent = model

                    local nameLabel = Instance.new("TextLabel")
                    nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
                    nameLabel.Position = UDim2.new(0, 0, 0, 0)
                    nameLabel.BackgroundTransparency = 1
                    nameLabel.Text = model.Name
                    nameLabel.TextColor3 = Color3.new(1, 1, 1)
                    nameLabel.TextStrokeTransparency = 0.5
                    nameLabel.TextStrokeColor3 = Color3.fromRGB(100, 100, 100)
                    nameLabel.Font = Enum.Font.Antique
                    nameLabel.TextScaled = true
                    nameLabel.Parent = bill

                    local healthLabel = Instance.new("TextLabel")
                    healthLabel.Name = "HealthLabel"
                    healthLabel.Size = UDim2.new(1, 0, 0.5, 0)
                    healthLabel.Position = UDim2.new(0, 0, 0.5, 0)
                    healthLabel.BackgroundTransparency = 1
                    healthLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                    healthLabel.TextStrokeTransparency = 0.5
                    healthLabel.TextStrokeColor3 = Color3.fromRGB(100, 100, 100)
                    healthLabel.Font = Enum.Font.Antique
                    healthLabel.TextScaled = true
                    healthLabel.Parent = bill
                end

                local hum = model:FindFirstChildOfClass("Humanoid")
                if hum then
                    local label = model.ESPText and model.ESPText:FindFirstChild("HealthLabel")
                    if label then
                        label.Text = math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth)
                    end
                end

                if not model:FindFirstChild("ESPHighlight") then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "ESPHighlight"
                    highlight.Adornee = model
                    highlight.FillColor = Color3.fromRGB(180, 180, 180)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0
                    highlight.Parent = model
                end
            end
        end
    end
end

local function removeSurvivorESP()
    if workspace.Players and workspace.Players.Survivors then
        for _, model in pairs(workspace.Players.Survivors:GetChildren()) do
            local esp = model:FindFirstChild("ESPText")
            if esp then esp:Destroy() end
            local h = model:FindFirstChild("ESPHighlight")
            if h then h:Destroy() end
        end
    end
end

-- Variables for TPWalk
local tpwalkEnabled = false
local tpwalkSpeed = 4

-- TPWalk implementation
RunService.Heartbeat:Connect(function()
    if tpwalkEnabled and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local root = player.Character.HumanoidRootPart
        local direction = Vector3.new()
        local cam = workspace.CurrentCamera
        local moveVec = Vector3.new()
        local userInputService = game:GetService("UserInputService")

        -- Getting input vector from WASD
        if userInputService:IsKeyDown(Enum.KeyCode.W) then
            moveVec = moveVec + cam.CFrame.LookVector
        end
        if userInputService:IsKeyDown(Enum.KeyCode.S) then
            moveVec = moveVec - cam.CFrame.LookVector
        end
        if userInputService:IsKeyDown(Enum.KeyCode.A) then
            moveVec = moveVec - cam.CFrame.RightVector
        end
        if userInputService:IsKeyDown(Enum.KeyCode.D) then
            moveVec = moveVec + cam.CFrame.RightVector
        end
        moveVec = Vector3.new(moveVec.X, 0, moveVec.Z).Unit

        if moveVec.Magnitude > 0 then
            local newPos = root.Position + moveVec * tpwalkSpeed * RunService.Heartbeat:Wait()
            root.CFrame = CFrame.new(newPos.X, root.Position.Y, newPos.Z)
        end
    end
end)

