-- AxionHazen | Forsaken ESP & Systems

local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

local antiGuestBlockEnabled = false
local tpWalkEnabled = false
local tpWalkSpeed = 4
local invisibilityEnabled = false
local infStaminaEnabled = false
local killerESPEnabled = false
local survivorESPEnabled = false

local blockAnimationId = "72722244508749"
local invisAnimId = "rbxassetid://75804462760596"

-- WINDOW
local Window = Rayfield:CreateWindow({
    Name = "AxionHazen | Forsaken BETA VERSION",
    LoadingTitle = "AxionHazenBETA | Loading",
    LoadingSubtitle = "by kah.over",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = nil,
        FileName = "AxionConfig"
    },
    Discord = { Enabled = false },
    KeySystem = true,
    KeySettings = {
        Title = "AxionHazen | KeySystem",
        Subtitle = "Enter the Key",
        Note = "Join Discord for Key",
        FileName = "AxionKey",
        SaveKey = true,
        GrabKeyFromSite = false,
        Key = "AxionNotBad", "key"
    }
})

-- MAIN TAB
local MainTab = Window:CreateTab("Main", 4483362458)

MainTab:CreateToggle({
    Name = "Anti GuestBlock Animation",
    CurrentValue = false,
    Callback = function(v)
        antiGuestBlockEnabled = v
    end
})

MainTab:CreateInput({
    Name = "TPWalk Speed (studs/sec)",
    PlaceholderText = "Default: 4",
    RemoveTextAfterFocusLost = false,
    Callback = function(input)
        local n = tonumber(input)
        tpWalkSpeed = (n and n > 0) and n or 4
    end
})

MainTab:CreateToggle({
    Name = "TPWalk",
    CurrentValue = false,
    Callback = function(state)
        tpWalkEnabled = state
    end
})

MainTab:CreateToggle({
    Name = "Invisibility",
    CurrentValue = false,
    Callback = function(v)
        invisibilityEnabled = v
    end
})

MainTab:CreateToggle({
    Name = "Inf staminaV1",
    CurrentValue = false,
    Callback = function(v)
        infStaminaEnabled = v
        local m = require(game:GetService("ReplicatedStorage"):WaitForChild("Modules"):WaitForChild("Shared"):WaitForChild("PlayerValues"))
        if v then
            m.MaxStamina = 100000
            m.StaminaGain = 1000000
        else
            m.MaxStamina = 100
            m.StaminaGain = 10
        end
    end
})

MainTab:CreateToggle({
    Name = "ESP Killer",
    CurrentValue = false,
    Callback = function(v)
        killerESPEnabled = v
    end
})

MainTab:CreateToggle({
    Name = "ESP Survivor",
    CurrentValue = false,
    Callback = function(v)
        survivorESPEnabled = v
    end
})

-- GUEST BLOCK BLOCKER
RunService.RenderStepped:Connect(function()
    if antiGuestBlockEnabled and player.Character then
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        local animator = humanoid and humanoid:FindFirstChildWhichIsA("Animator")
        if animator then
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                if track.Animation and string.find(track.Animation.AnimationId, blockAnimationId) then
                    track:Stop()
                end
            end
        end
    end
end)

-- INVIS LOOP
RunService.Heartbeat:Connect(function()
    if player.Character then
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
        if animator and invisibilityEnabled then
            local anim = Instance.new("Animation")
            anim.AnimationId = invisAnimId
            local track = animator:LoadAnimation(anim)
            track:Play(0.1, 1, 1)
            task.delay(0.01, function() track:Stop() end)
        elseif animator and not invisibilityEnabled then
            for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
                t:Stop()
            end
        end
    end
end)

-- TPWALK LOOP
task.spawn(function()
    while true do
        task.wait(0.1)
        if tpWalkEnabled then
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            if hrp and humanoid then
                local dir = humanoid.MoveDirection
                if dir.Magnitude > 0 then
                    hrp.CFrame = hrp.CFrame + (dir.Unit * (tpWalkSpeed * 0.1))
                end
            end
        end
    end
end)

-- ESP LOOP
local function updateKillerESP()
    for _, model in pairs(workspace.Players.Killers:GetChildren()) do
        if model:IsA("Model") and model:FindFirstChild("HumanoidRootPart") then
            if not model:FindFirstChild("ESPHighlight") then
                local h = Instance.new("Highlight")
                h.Name = "ESPHighlight"
                h.Adornee = model
                h.FillColor = Color3.fromRGB(85, 0, 0)
                h.OutlineColor = Color3.fromRGB(255, 0, 0)
                h.FillTransparency = 0.5
                h.OutlineTransparency = 0
                h.Parent = model
            end
            if not model:FindFirstChild("ESPText") and model:FindFirstChild("Head") then
                local bill = Instance.new("BillboardGui")
                bill.Name = "ESPText"
                bill.Adornee = model.Head
                bill.Size = UDim2.new(0, 200, 0, 40)
                bill.StudsOffset = Vector3.new(0, 2, 0)
                bill.AlwaysOnTop = true
                bill.Parent = model

                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(1, 0, 1, 0)
                label.BackgroundTransparency = 1
                label.Text = model.Name
                label.TextColor3 = Color3.fromRGB(255, 0, 0)
                label.TextStrokeTransparency = 0.2
                label.TextStrokeColor3 = Color3.fromRGB(85, 0, 0)
                label.Font = Enum.Font.Antique
                label.TextScaled = true
                label.Parent = bill
            end
        end
    end
end

local function updateSurvivorESP()
    for _, model in pairs(workspace.Players.Survivors:GetChildren()) do
        if model:IsA("Model") and model:FindFirstChild("Head") then
            if not model:FindFirstChild("ESPText") then
                local bill = Instance.new("BillboardGui")
                bill.Name = "ESPText"
                bill.Adornee = model.Head
                bill.Size = UDim2.new(0, 200, 0, 40)
                bill.StudsOffset = Vector3.new(0, 2, 0)
                bill.AlwaysOnTop = true
                bill.Parent = model

                local nameLabel = Instance.new("TextLabel")
                nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
                nameLabel.BackgroundTransparency = 1
                nameLabel.Text = model.Name
                nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                nameLabel.TextStrokeTransparency = 0.5
                nameLabel.TextStrokeColor3 = Color3.fromRGB(100, 100, 100)
                nameLabel.Font = Enum.Font.Antique
                nameLabel.TextScaled = true
                nameLabel.Parent = bill

                local healthLabel = Instance.new("TextLabel")
                healthLabel.Size = UDim2.new(1, 0, 0.5, 0)
                healthLabel.Position = UDim2.new(0, 0, 0.5, 0)
                healthLabel.BackgroundTransparency = 1
                healthLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                healthLabel.TextStrokeTransparency = 0.5
                healthLabel.TextStrokeColor3 = Color3.fromRGB(100, 100, 100)
                healthLabel.Font = Enum.Font.Antique
                healthLabel.TextScaled = true
                healthLabel.Name = "HealthLabel"
                healthLabel.Parent = bill
            end

            local hum = model:FindFirstChildOfClass("Humanoid")
            if hum then
                local label = model:FindFirstChild("ESPText") and model.ESPText:FindFirstChild("HealthLabel")
                if label then
                    label.Text = math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth)
                end
            end

            if not model:FindFirstChild("ESPHighlight") then
                local highlight = Instance.new("Highlight")
                highlight.Name = "ESPHighlight"
                highlight.Adornee = model
                highlight.FillColor = Color3.fromRGB(180, 180, 180)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.5
                highlight.OutlineTransparency = 0
                highlight.Parent = model
            end
        end
    end
end

while true do
    task.wait(1)
    if killerESPEnabled then updateKillerESP() end
    if survivorESPEnabled then updateSurvivorESP() end
end
